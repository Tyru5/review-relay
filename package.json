{
  "name": "review-relay",
  "version": "0.7.0",
  "private": true,
  "description": "Runs local AI agent reviews (Claude Code, Codex, and 11 other agent CLIs) on GitHub pull requests and posts a 1-5 merge confidence score.",
  "homepage": "https://reviewrelay.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyru5/review-relay.git"
  },
  "bin": {
    "review-relay": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release": "bun scripts/release.ts",
    "release:build": "bun scripts/release.ts --skip-upload",
    "site:dev": "bun install --cwd site && bun run --cwd site dev",
    "site:build": "bun install --cwd site && bun run --cwd site build",
    "site:preview": "bun run --cwd site preview",
    "site:tunnel": "cloudflared tunnel --url http://127.0.0.1:3000",
    "relay": "scripts/relay",
    "relay:setup": "scripts/relay setup",
    "relay:start": "scripts/relay start",
    "relay:stop": "scripts/relay stop",
    "relay:killall": "scripts/relay killall",
    "relay:restart": "scripts/relay restart",
    "relay:status": "scripts/relay status",
    "relay:tui": "scripts/relay tui",
    "relay:info": "scripts/relay info",
    "relay:logs": "scripts/relay logs",
    "relay:help": "scripts/relay help",
    "relay:config": "scripts/relay config",
    "relay:run": "scripts/relay run",
    "relay:route": "scripts/relay route",
    "relay:replay": "scripts/relay replay",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint:check && bun run fmt:check && bun test",
    "ci:local": "act pull_request -j check --pull=false -P ubuntu-latest=catthehacker/ubuntu:act-latest",
    "ci:local:pull": "act pull_request -j check -P ubuntu-latest=catthehacker/ubuntu:act-latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.9.0"
  }
}
