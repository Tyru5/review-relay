#!/usr/bin/env bash
# Thin wrapper around the CLI for repo checkouts: scripts/relay <command> == bun src/cli.ts <command>.
# `start` runs in the background here, matching the old script; use `bun src/cli.ts start` for the foreground.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v bun >/dev/null || { echo "bun not found" >&2; exit 1; }
cmd="${1:-help}"; shift || true
case "$cmd" in
  start) exec bun "$ROOT/src/cli.ts" start --detach "$@" ;;
  killall)
    # Stops every daemon on the box (installed binary, worktrees, foreground runs), not just the pidfile one.
    # SIGTERM first so forwarders remove their temporary webhooks; SIGKILL whatever is left after 10s.
    pat='^(\S*/)?(review-relay|bun \S*/src/cli\.ts) start'
    read -ra pids <<< "$(pgrep -f "$pat" | tr '\n' ' ')"
    ((${#pids[@]})) || { echo "no daemons running"; exit 0; }
    ps -o pid=,args= -p "$(IFS=,; echo "${pids[*]}")"
    kill "${pids[@]}" 2>/dev/null || true
    for _ in {1..20}; do pgrep -f "$pat" >/dev/null || { echo "stopped"; exit 0; }; sleep 0.5; done
    read -ra left <<< "$(pgrep -f "$pat" | tr '\n' ' ')"; echo "force-killing: ${left[*]}"; kill -9 "${left[@]}" 2>/dev/null || true ;;
  logs)
    # Old form: logs [N] [-f|--follow]; -f and --follow are flags, N is positional.
    args=(); for a in "$@"; do [[ "$a" == --follow ]] && a=-f; args+=("$a"); done
    exec bun "$ROOT/src/cli.ts" logs "${args[@]}" ;;
  *) exec bun "$ROOT/src/cli.ts" "$cmd" "$@" ;;
esac
