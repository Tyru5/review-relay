{
  "port": 9988,
  "graceMs": 120000,
  "timeoutMs": 1800000,
  "reviewers": ["codex", "claude"],
  "models": {
    "claude": { "model": "claude-opus-5-5", "effort": "max" },
    "codex": { "model": "gpt-6-astra", "effort": "high" }
  },
  "repos": [
    {
      "fullName": "owner/repo",
      "localPath": "~/code/repo",
      "trigger": "auto",
      "postToPr": true
    },
    {
      "fullName": "owner/repo-without-ai-reviewer",
      "localPath": "~/code/repo-without-ai-reviewer",
      "trigger": "github",
      "postToPr": true,
      "github": { "onPush": true, "mention": "@review-relay" }
    }
  ]
}
