{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "reports", "worktrees", "test/fixtures"],
  "rules": {
    "unicorn/consistent-function-scoping": "off"
  }
}
